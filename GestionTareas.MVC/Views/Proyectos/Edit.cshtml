@model GestionTareas.API.Models.Proyecto

@{
    ViewData["Title"] = "Editar Proyecto";
}

<h2>Editar Proyecto</h2>

<form method="post">
    <div class="form-group">
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" id="Nombre" name="Nombre" value="@Model.Nombre" required />
    </div>

    <div class="form-group">
        <label for="Descripcion">Descripción</label>
        <textarea class="form-control" id="Descripcion" name="Descripcion" required>@Model.Descripcion</textarea>
    </div>

    <div class="form-group">
        <label for="FechaInicio">Fecha de Inicio</label>
        <input type="date" class="form-control" id="FechaInicio" name="FechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="form-group">
        <label for="FechaFin">Fecha de Fin</label>
        <input type="date" class="form-control" id="FechaFin" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        <label for="Estado">Estado</label>
        <input type="text" class="form-control" id="Estado" name="Estado" value="@Model.Estado" required />
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
</form>

<a href="@Url.Action("Index", "Proyectos")" class="btn btn-primary">Volver</a>
